# Server Configuration
PORT=4000
NODE_ENV=development

# Security
JWT_SECRET=reelvault_super_secure_jwt_secret_change_in_production_min32chars
SESSION_EXPIRES_IN=7d

# Database Configuration
# Uses built-in SQLite file by default (zero setup).
DATABASE_PATH=./data/reelvault.sqlite

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Optional Analytics & Spam Protection
VITE_ANALYTICS_ID=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=
